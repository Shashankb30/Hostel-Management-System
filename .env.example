# Copy to .env for local development; do not commit secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite is the default. For PostgreSQL set DB_ENGINE=django.db.backends.postgresql
# DB_NAME=hostel_management
# DB_USER=hms_user
# DB_PASSWORD=replace-me
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Lock an account after this many wrong passwords in a row (FR-01.11).
HMS_MAX_FAILED_LOGINS=5
# Minutes of inactivity before a user is logged out (FR-01.07).
HMS_SESSION_TIMEOUT_MINUTES=30
